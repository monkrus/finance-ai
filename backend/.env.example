# FinPilot AI - Environment Variables Template
ENVIRONMENT=development

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_random_key_of_at_least_32_characters_here
# Short-lived access tokens (minutes). Long-lived sessions use refresh-token rotation.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Comma-separated allowed CORS origins (set to your real frontend URL in prod).
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/finpilot

# Redis Connection
REDIS_URL=redis://redis:6379/0

# AI Gateway API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Market Data API Keys
FMP_API_KEY=your_fmp_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FRED_API_KEY=your_fred_api_key_here
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
